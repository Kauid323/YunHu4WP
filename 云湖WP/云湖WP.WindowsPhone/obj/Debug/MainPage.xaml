<Page
    x:Class="云湖WP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:云湖WP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- 原生 Windows Phone Metro Pivot 容器：左上角小标题“云湖”，原生水平滑动 -->
        <Pivot x:ConnectionId='1' Title="云湖" x:Name="MainPivot" Margin="0"                                              >
            
            <!-- 1. 消息列表 (对接 Protobuf /v1/conversation/list) -->
            <PivotItem Header="消息" Margin="0">
                <Grid Margin="0">
                    <ProgressBar x:Name="ConvProgressBar" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="{ThemeResource PhoneAccentBrush}" Canvas.ZIndex="10"/>
                    
                    <!-- 空状态提示 -->
                    <StackPanel x:Name="EmptyConvPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0,16,0">
                        <TextBlock Text="暂无会话消息" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="点击下方 + 即可发起新对话或加入群聊" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 会话列表视图 (原生 Windows Phone 虚拟化列表) -->
                    <ListView x:ConnectionId='14' x:Name="ConvListView" 
                              SelectionMode="None" 
                              IsItemClickEnabled="True" 
                                                                
                                                          
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="16,12" Background="Transparent" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 正方形头像（Metro 几何直角，无圆角） -->
                                        <Grid Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource PhoneAccentBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock Text="{Binding AvatarLetter}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding AvatarBitmap}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ChatContent}" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- 2. 联系人与群组 -->
            <PivotItem Header="联系人" Margin="0">
                <ScrollViewer x:ConnectionId='8' x:Name="ContactsScrollViewer"
                              HorizontalScrollMode="Disabled" 
                              HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollMode="Auto" 
                              VerticalScrollBarVisibility="Auto"
                                                                     >
                    <StackPanel Margin="16,10,16,24">
                        <!-- 分类导航 -->
                        <Border x:ConnectionId='9' BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,10" Background="Transparent"                                >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="{ThemeResource PhoneAccentBrush}">
                                    <SymbolIcon Symbol="People" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="我的好友" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:ConnectionId='10' BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,10" Background="Transparent"                                >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="#FF607D8B">
                                    <SymbolIcon Symbol="AllApps" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="加入的群聊" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:ConnectionId='11' BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,10" Background="Transparent"                                >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="#FF009688">
                                    <SymbolIcon Symbol="Repair" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="官方机器人" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 最近联系人小标题 -->
                        <TextBlock Text="常用联系" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PhoneAccentBrush}" Margin="0,20,0,8" />

                        <!-- 联系人条目 -->
                        <Border x:ConnectionId='12' BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,10" Background="Transparent"                            >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Background="{ThemeResource PhoneAccentBrush}">
                                    <TextBlock Text="小" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="小湖同学" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="[在线] 智能 AI 助手" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:ConnectionId='13' BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,10" Background="Transparent"                            >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Background="#FF0288D1">
                                    <TextBlock Text="湖" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="湖友会 (频道)" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="活跃成员 256 人" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 3. 动态广场 -->
            <!-- 3. 动态广场 (社区文章与推荐动态) -->
            <PivotItem Header="动态" Margin="0">
                <Grid Margin="0">
                    <ProgressBar x:Name="CommunityProgressBar" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="{ThemeResource PhoneAccentBrush}" Canvas.ZIndex="10"/>

                    <!-- 空状态提示 -->
                    <StackPanel x:Name="EmptyCommunityPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0,16,0">
                        <TextBlock Text="暂无动态内容" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="点击下方刷新或切换筛选查看最新分享" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 动态列表视图 (Metro 纯几何卡片) -->
                    <ListView x:ConnectionId='7' x:Name="CommunityListView"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                                                                     
                                                               
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Padding="16,10">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,12" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" BorderBrush="#25FFFFFF" Background="#0AFFFFFF" Padding="14">
                                    <StackPanel>
                                        <!-- 作者信息行 -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- 作者头像 (纯直角 Metro 32x32) -->
                                            <Grid Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border Background="{ThemeResource PhoneAccentBrush}">
                                                    <TextBlock Text="{Binding DisplayAvatarLetter}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding AvatarBitmap}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding DisplayAuthor}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayTime}" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 文章标题 (加粗) -->
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />

                                        <!-- 文章内容预览 (精简段落) -->
                                        <TextBlock Text="{Binding Content}" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" TextWrapping="Wrap" LineHeight="18" MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

                                        <!-- 统计信息行 (点赞数、评论数、收藏数、投币数) -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 1. 点赞数 -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE19F;" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LikeText}" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- 2. 评论数 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <SymbolIcon Symbol="Message" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CommentText}" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- 3. 收藏数 -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <SymbolIcon Symbol="Favorite" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CollectText}" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- 4. 投币数 -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE13D;" FontSize="11" Foreground="{ThemeResource PhoneAccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding AmountText}" FontSize="11" Foreground="{ThemeResource PhoneAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- 4. 我的信息 -->
            <PivotItem Header="我" Margin="0">
                <ScrollViewer x:ConnectionId='2' x:Name="MeScrollViewer"
                              HorizontalScrollMode="Disabled" 
                              HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollMode="Auto" 
                              VerticalScrollBarVisibility="Auto"
                                                                     >
                    <StackPanel Margin="16,10,16,24">
                        <!-- 用户名片（Metro 锐角纯净磁贴风格） -->
                        <Border x:ConnectionId='3' BorderThickness="1" BorderBrush="#22FFFFFF" Background="#0AFFFFFF" Padding="16" Margin="0,0,0,20"                                >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 大头像方块（Metro 几何直角，无圆角） -->
                                <Grid Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Border Background="{ThemeResource PhoneAccentBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock x:Name="TxtAvatarInitial" Text="用" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image x:Name="ImgUserAvatar" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="TxtDisplayName" Text="云湖用户" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TxtAccount" Text="账号: 未知" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,4,0,6" TextTrimming="CharacterEllipsis" />
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{ThemeResource PhoneAccentBrush}" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock x:Name="TxtVipStatus" Text="普通用户" FontSize="11" Foreground="White" />
                                        </Border>
                                        <Border Background="#22FFFFFF" Padding="6,2">
                                            <TextBlock x:Name="TxtCoinCount" Text="金币: 0" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 功能菜单列表 -->
                        <TextBlock Text="个人服务" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PhoneAccentBrush}" Margin="0,0,0,8" />

                        <Border x:ConnectionId='4' BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,12" Background="Transparent"                                >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="个人资料与标签" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:ConnectionId='5' BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,12" Background="Transparent"                            >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="表情收藏与贴纸" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border x:ConnectionId='6' BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,12" Background="Transparent"                             >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="设置" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>

    <!-- 原生 Windows Phone 8.1 底部应用栏 CommandBar (支持滑动自动折叠收回与停止滑动自动展开) -->
    <Page.BottomAppBar>
        <CommandBar x:Name="MainCommandBar" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" ClosedDisplayMode="Compact">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:ConnectionId='15' x:Name="AppBarBtnRefresh" Icon="Refresh" Label="刷新"                                />
                <AppBarButton x:Name="AppBarBtnFilter" Icon="Filter" Label="筛选" Visibility="Collapsed">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:ConnectionId='18' x:Name="FlyoutItemLatest" Text="最新文章 (当前)"                            />
                            <MenuFlyoutItem x:ConnectionId='19' x:Name="FlyoutItemHot" Text="热门推荐"                         />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:ConnectionId='16' x:Name="AppBarBtnNewChat" Icon="Add" Label="发起聊天"                                />
                <AppBarButton x:ConnectionId='17' x:Name="AppBarBtnSearch" Icon="Find" Label="搜索"                               />
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:ConnectionId='20' x:Name="AppBarBtnSettings" Label="设置"                                 />
                <AppBarButton x:ConnectionId='21' x:Name="AppBarBtnLogout" Label="退出登录"                               />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>

