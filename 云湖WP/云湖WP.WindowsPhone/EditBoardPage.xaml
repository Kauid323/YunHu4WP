<Page
    x:Class="云湖WP.EditBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:云湖WP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ProgressBar x:Name="ActionProgressBar" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="{ThemeResource PhoneAccentBrush}" Canvas.ZIndex="100" Grid.RowSpan="2"/>

        <!-- 大标题 -->
        <StackPanel Grid.Row="0" Margin="19,18,19,12">
            <TextBlock Text="云湖" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" Typography.Capitals="SmallCaps"/>
            <TextBlock Text="编辑板块" FontSize="42" FontWeight="Light" Margin="0,-4,0,0"/>
        </StackPanel>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="19,0,19,40">
                <!-- 板块名称 -->
                <TextBlock Text="板块名称" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtBoardName"
                         PlaceholderText="输入板块名称（最多10字）"
                         FontSize="16"
                         MaxLength="10"
                         Margin="0,0,0,20"/>

                <!-- 板块头像 URL -->
                <TextBlock Text="板块头像 URL" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtAvatarUrl"
                         PlaceholderText="输入头像图片 URL（可留空保持原头像）"
                         FontSize="16"
                         Margin="0,0,0,20"/>

                <!-- 当前头像预览 -->
                <TextBlock x:Name="TxtAvatarHint" Text="" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar x:Name="EditBoardCommandBar" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" ClosedDisplayMode="Minimal">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="AppBarBtnSave" Icon="Save" Label="保存" Click="AppBarBtnSave_Click"/>
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
