<Page
    x:Class="云湖WP.ProfileEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:云湖WP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. 原生 Windows Phone 大标题顶栏 -->
        <StackPanel Grid.Row="0" Margin="19,18,19,8">
            <TextBlock Text="云湖" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" Typography.Capitals="SmallCaps" />
            <TextBlock Text="资料修改" FontSize="42" FontWeight="Light" Margin="0,-4,0,0" />
        </StackPanel>

        <!-- 2. 编辑表单区 (原生 WP 纯居左排版) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="19,10,19,24">
                <ProgressBar x:Name="EditProgressBar" IsIndeterminate="True" Visibility="Collapsed" Foreground="{ThemeResource PhoneAccentBrush}" Margin="0,0,0,12" />

                <!-- 昵称 -->
                <TextBox x:Name="TxtName" 
                         Header="昵称" 
                         PlaceholderText="输入你的昵称" 
                         FontSize="16" 
                         Margin="0,0,0,16" 
                         HorizontalAlignment="Stretch" />

                <!-- 性别 -->
                <ComboBox x:Name="ComboGender" 
                          Header="性别" 
                          FontSize="16" 
                          Margin="0,0,0,16" 
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="保密" IsSelected="True" />
                    <ComboBoxItem Content="男" />
                    <ComboBoxItem Content="女" />
                </ComboBox>

                <!-- 个性签名 / 简介 -->
                <TextBox x:Name="TxtIntroduction" 
                         Header="个性签名 / 简介" 
                         PlaceholderText="分享你的心情与想法..." 
                         AcceptsReturn="True" 
                         Height="90" 
                         FontSize="15" 
                         Margin="0,0,0,16" 
                         HorizontalAlignment="Stretch" />

                <!-- 所在地区 / 城市 -->
                <TextBox x:Name="TxtCity" 
                         Header="城市 / 地区" 
                         PlaceholderText="例如: 北京 / 湖北武汉" 
                         FontSize="16" 
                         Margin="0,0,0,24" 
                         HorizontalAlignment="Stretch" />

                <!-- 保存按钮 (Metro 实色方块) -->
                <Button x:Name="BtnSave" 
                        Content="保 存" 
                        HorizontalAlignment="Stretch" 
                        Height="48" 
                        FontSize="16" 
                        FontWeight="SemiBold" 
                        Background="{ThemeResource PhoneAccentBrush}" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Click="BtnSave_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
