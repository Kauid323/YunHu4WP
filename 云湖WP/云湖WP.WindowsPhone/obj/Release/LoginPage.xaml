<Page
    x:Class="云湖WP.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:云湖WP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- 原生 Windows Phone Pivot：左上角小字号“云湖”标题，精炼标签名，全宽铺满 -->
        <Pivot x:ConnectionId='1' Title="云湖" x:Name="LoginPivot" Margin="0"                                               >
            <!-- 邮箱 -->
            <PivotItem Header="邮箱" Margin="0">
                <ScrollViewer HorizontalScrollMode="Disabled" 
                              HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollMode="Auto" 
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,36">
                        <!-- 邮箱输入 -->
                        <TextBox x:Name="TxtEmail"
                                 Header="邮箱"
                                 PlaceholderText="请输入邮箱地址"
                                 InputScope="EmailSmtpAddress"
                                 HorizontalAlignment="Stretch"
                                 FontSize="16"
                                 Margin="0,0,0,20" />

                        <!-- 密码输入 -->
                        <PasswordBox x:Name="TxtEmailPassword"
                                     Header="密码"
                                     PlaceholderText="请输入登录密码"
                                     HorizontalAlignment="Stretch"
                                     FontSize="16"
                                     Margin="0,0,0,16" />

                        <!-- 记住我与忘记密码 -->
                        <Grid Margin="0,4,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkRememberMe" 
                                      Content="记住我" 
                                      IsChecked="True" 
                                      FontSize="15" 
                                      VerticalAlignment="Center" />
                            <HyperlinkButton x:ConnectionId='6' x:Name="BtnForgotPassword" 
                                             Grid.Column="1" 
                                             Content="忘记密码?" 
                                             FontSize="15" 
                                             Foreground="{ThemeResource PhoneAccentBrush}"
                                             VerticalAlignment="Center" 
                                                                             />
                        </Grid>

                        <!-- 邮箱登录按钮 -->
                        <Button x:ConnectionId='5' x:Name="BtnEmailLogin" 
                                Content="登 录" 
                                HorizontalAlignment="Stretch" 
                                Height="52"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Background="{ThemeResource PhoneAccentBrush}"
                                Foreground="White"
                                                            />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 手机号 -->
            <PivotItem Header="手机号" Margin="0">
                <ScrollViewer HorizontalScrollMode="Disabled" 
                              HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollMode="Auto" 
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,36">
                        <!-- 手机号输入 -->
                        <TextBox x:Name="TxtPhone"
                                 Header="手机号"
                                 PlaceholderText="请输入11位手机号"
                                 InputScope="TelephoneNumber"
                                 HorizontalAlignment="Stretch"
                                 FontSize="16"
                                 Margin="0,0,0,16" />

                        <!-- 图形验证码 (自适应等比显示，点击图片随时刷新) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtImageCode"
                                     Header="图形验证码"
                                     PlaceholderText="输入图形码"
                                     InputScope="AlphanumericHalfWidth"
                                     FontSize="16"
                                     Grid.Column="0" />

                            <Border x:ConnectionId='4' Grid.Column="2"
                                    VerticalAlignment="Bottom"
                                    Height="42"
                                    Background="#15FFFFFF"
                                    BorderBrush="{ThemeResource PhoneMidBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,2"
                                                              >
                                <Grid>
                                    <Image x:Name="ImgCaptcha" 
                                           Stretch="Uniform" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtCaptchaTip" 
                                               Text="点击获取" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource PhoneMidBrush}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 短信验证码输入与获取按钮 -->
                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtVerifyCode"
                                     Header="短信验证码"
                                     PlaceholderText="6位短信码"
                                     InputScope="Number"
                                     FontSize="16"
                                     Grid.Column="0" />

                            <Button x:ConnectionId='3' x:Name="BtnGetVerifyCode"
                                    Content="获取验证码"
                                    Grid.Column="2"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"
                                    Height="42"
                                    FontSize="13"
                                    Margin="0,0,0,2"
                                                                   />
                        </Grid>

                        <!-- 手机号登录按钮 -->
                        <Button x:ConnectionId='2' x:Name="BtnPhoneLogin" 
                                Content="登 录" 
                                HorizontalAlignment="Stretch" 
                                Height="52"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Background="{ThemeResource PhoneAccentBrush}"
                                Foreground="White"
                                                            />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <!-- 登录加载指示遮罩层 (全屏覆盖) -->
        <Grid x:Name="LoadingOverlay" 
              Background="#99000000" 
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing x:Name="ProgressIndicator" 
                              Width="48" 
                              Height="48" 
                              IsActive="False" 
                              Foreground="{ThemeResource PhoneAccentBrush}"/>
                <TextBlock x:Name="TxtLoadingStatus" 
                           Text="正在登录中..." 
                           FontSize="15" 
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

