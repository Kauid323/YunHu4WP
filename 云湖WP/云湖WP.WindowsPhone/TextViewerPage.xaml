<Page
    x:Class="云湖WP.TextViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:云湖WP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Metro 风格大标题 (云湖 / 查看与复制) -->
        <StackPanel x:Name="HeaderPanel" Grid.Row="0" Margin="19,10,19,6">
            <TextBlock x:Name="TxtSubTitle" Text="云湖" FontSize="11" FontWeight="Normal" Foreground="{ThemeResource PhoneMidBrush}" />
            <TextBlock x:Name="TxtPageTitle" Text="查看与复制" FontSize="42" FontWeight="Light" Margin="0,-4,0,0" />
        </StackPanel>

        <!-- 内容区域：包含 TextBox (文本模式) 与 WebView (网页渲染模式) -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <!-- 纯文本输入/查看/复制框 -->
            <TextBox x:Name="TxtMainContent"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontSize="16"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch" />

            <!-- WebView 网页渲染视图 -->
            <WebView x:Name="WebMainContent"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Visibility="Collapsed" />
        </Grid>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar x:Name="ViewerCommandBar" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" ClosedDisplayMode="Compact">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="AppBarBtnSelectAll" Icon="SelectAll" Label="全选" Click="AppBarBtnSelectAll_Click" />
                <AppBarButton x:Name="AppBarBtnToggleWeb" Icon="Globe" Label="WebView渲染" Click="AppBarBtnToggleWeb_Click" />
                <AppBarButton x:Name="AppBarBtnBrowser" Icon="OpenFile" Label="系统浏览器" Click="AppBarBtnBrowser_Click" />
                <AppBarButton x:Name="AppBarBtnClear" Icon="Clear" Label="清空" Click="AppBarBtnClear_Click" />
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
