<Page
    x:Class="云湖WP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:云湖WP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- 原生 Windows Phone Metro Pivot 容器：左上角小标题“云湖”，原生水平滑动 -->
        <Pivot Title="云湖" x:Name="MainPivot" Margin="0">
            
            <!-- 1. 消息列表 (对接 Protobuf /v1/conversation/list) -->
            <PivotItem Header="消息" Margin="0">
                <Grid Margin="0">
                    <ProgressBar x:Name="ConvProgressBar" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="{ThemeResource PhoneAccentBrush}" Canvas.ZIndex="10"/>
                    
                    <!-- 空状态提示 -->
                    <StackPanel x:Name="EmptyConvPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0,16,0">
                        <TextBlock Text="暂无会话消息" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="点击下方 + 即可发起新对话或加入群聊" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 会话列表视图 (原生 Windows Phone 虚拟化列表) -->
                    <ListView x:Name="ConvListView" 
                              SelectionMode="None" 
                              IsItemClickEnabled="True" 
                              ItemClick="ConvListView_ItemClick"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="16,12" Background="Transparent" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 正方形头像（Metro 几何直角，无圆角） -->
                                        <Grid Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource PhoneAccentBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock Text="{Binding AvatarLetter}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding AvatarBitmap}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ChatContent}" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- 2. 联系人与群组 -->
            <PivotItem Header="联系人" Margin="0">
                <ScrollViewer HorizontalScrollMode="Disabled" 
                              HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollMode="Auto" 
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,10,16,24">
                        <!-- 分类导航 -->
                        <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,10" Background="Transparent" Tapped="ContactCategory_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="{ThemeResource PhoneAccentBrush}">
                                    <SymbolIcon Symbol="People" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="我的好友" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,10" Background="Transparent" Tapped="ContactCategory_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="#FF607D8B">
                                    <SymbolIcon Symbol="AllApps" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="加入的群聊" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,10" Background="Transparent" Tapped="ContactCategory_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="#FF009688">
                                    <SymbolIcon Symbol="Repair" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="官方机器人" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 最近联系人小标题 -->
                        <TextBlock Text="常用联系" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PhoneAccentBrush}" Margin="0,20,0,8" />

                        <!-- 联系人条目 -->
                        <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,10" Background="Transparent" Tapped="ContactItem_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Background="{ThemeResource PhoneAccentBrush}">
                                    <TextBlock Text="小" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="小湖同学" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="[在线] 智能 AI 助手" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,10" Background="Transparent" Tapped="ContactItem_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Background="#FF0288D1">
                                    <TextBlock Text="湖" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="湖友会 (频道)" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="活跃成员 256 人" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 3. 动态广场 -->
            <PivotItem Header="动态" Margin="0">
                <ScrollViewer HorizontalScrollMode="Disabled" 
                              HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollMode="Auto" 
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,10,16,24">
                        <!-- 动态卡片 1（Metro 无圆角） -->
                        <Border BorderThickness="1" BorderBrush="#22FFFFFF" Background="#0AFFFFFF" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="{ThemeResource PhoneAccentBrush}">
                                        <TextBlock Text="湖" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="云湖官方团队" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="今天 09:00" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource PhoneAccentBrush}" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="官方" FontSize="10" Foreground="White" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="云湖 Windows Phone 客户端正式启航！" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,6" TextWrapping="Wrap" />
                                <TextBlock Text="基于原生 WinRT Metro 现代设计风格，纯粹矩形方块，无圆角，超轻量，回归纯粹的沟通体验。" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Like" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="128 点赞" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Comment" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="32 评论" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 动态卡片 2 -->
                        <Border BorderThickness="1" BorderBrush="#22FFFFFF" Background="#0AFFFFFF" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="#FF7B1FA2">
                                        <TextBlock Text="极" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="极客讨论区" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="昨天 18:40" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="WP8.1 Metro 现代磁贴设计为什么如此令人着迷？" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,6" TextWrapping="Wrap" />
                                <TextBlock Text="排版至上，几何直角，超清爽的信息流动，在如今圆角泛滥的时代尤为独特。" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Like" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="64 点赞" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Comment" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="19 评论" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 4. 我的信息 -->
            <PivotItem Header="我" Margin="0">
                <ScrollViewer HorizontalScrollMode="Disabled" 
                              HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollMode="Auto" 
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,10,16,24">
                        <!-- 用户名片（Metro 锐角纯净磁贴风格） -->
                        <Border BorderThickness="1" BorderBrush="#22FFFFFF" Background="#0AFFFFFF" Padding="16" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 大头像方块（Metro 几何直角，无圆角） -->
                                <Grid Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Border Background="{ThemeResource PhoneAccentBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <TextBlock x:Name="TxtAvatarInitial" Text="用" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image x:Name="ImgUserAvatar" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="TxtDisplayName" Text="云湖用户" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TxtAccount" Text="账号: 未知" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,4,0,6" TextTrimming="CharacterEllipsis" />
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{ThemeResource PhoneAccentBrush}" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock x:Name="TxtVipStatus" Text="普通用户" FontSize="11" Foreground="White" />
                                        </Border>
                                        <Border Background="#22FFFFFF" Padding="6,2">
                                            <TextBlock x:Name="TxtCoinCount" Text="金币: 0" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 设置与性能 -->
                        <TextBlock Text="设置与性能" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PhoneAccentBrush}" Margin="0,0,0,8" />

                        <!-- 图片加载与性能设置面板（Metro 锐角纯净磁贴风格） -->
                        <Border BorderThickness="1" BorderBrush="#22FFFFFF" Background="#0AFFFFFF" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="图片/头像性能设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="可开启无图省流模式或调整后台并发下载线程数" FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <!-- 完全不加载任何图片开关 -->
                                <ToggleSwitch x:Name="ToggleDisableImages" Header="完全不加载任何图片 (极速省流)" Toggled="ToggleDisableImages_Toggled" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="并发下载线程数" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtThreadCount" Grid.Column="1" Text="4 线程" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PhoneAccentBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <Slider x:Name="SliderThreads" Minimum="1" Maximum="16" StepFrequency="1" SmallChange="1" LargeChange="2" Value="4" ValueChanged="SliderThreads_ValueChanged" Margin="0,0,0,10"/>

                                <Button x:Name="BtnClearCache" Content="清除头像与图片缓存" HorizontalAlignment="Stretch" BorderThickness="1" Click="BtnClearCache_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 功能菜单列表 -->
                        <TextBlock Text="个人服务" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource PhoneAccentBrush}" Margin="0,0,0,8" />

                        <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,12" Background="Transparent" Tapped="ProfileMenu_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="个人资料与标签" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,12" Background="Transparent" Tapped="ProfileMenu_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="表情收藏与贴纸" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,12" Background="Transparent" Tapped="ProfileMenu_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="云盘网盘空间" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text=">" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border BorderThickness="0,0,0,1" BorderBrush="#1FFFFFFF" Padding="0,12" Background="Transparent" Tapped="BtnAbout_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关于云湖 WP" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="v1.0 >" FontSize="14" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>

    <!-- 原生 Windows Phone 8.1 底部应用栏 CommandBar -->
    <Page.BottomAppBar>
        <CommandBar Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="AppBarBtnRefresh" Icon="Refresh" Label="刷新" Click="AppBarBtnRefresh_Click" />
                <AppBarButton x:Name="AppBarBtnNewChat" Icon="Add" Label="发起聊天" Click="AppBarBtnNewChat_Click" />
                <AppBarButton x:Name="AppBarBtnSearch" Icon="Find" Label="搜索" Click="AppBarBtnSearch_Click" />
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="AppBarBtnSettings" Label="设置" Click="AppBarBtnSettings_Click" />
                <AppBarButton x:Name="AppBarBtnLogout" Label="退出登录" Click="AppBarBtnLogout_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>