<Page
    x:Class="云湖WP.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:云湖WP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 顶部 Metro 标题栏 (纯几何直角风格，适中高度) -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="10,6" Height="52">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 返回按钮 (原生 WinRT SymbolIcon) -->
                <Button x:Name="BtnBack" Width="40" Height="40" Padding="0" Margin="0" BorderThickness="0" Background="Transparent" Click="BtnBack_Click" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <SymbolIcon Symbol="Back" />
                </Button>

                <!-- 会话名称 (居中单行排版) -->
                <TextBlock x:Name="TxtChatTitle" Grid.Column="1" Text="云湖聊天" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,8,0" />

                <!-- 右上角刷新/选项按钮 (原生 WinRT SymbolIcon) -->
                <Button x:Name="BtnRefresh" Grid.Column="2" Width="40" Height="40" Padding="0" Margin="0" BorderThickness="0" Background="Transparent" Click="BtnRefresh_Click" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </Grid>
        </Border>

        <!-- 2. 中间消息列表容器 -->
        <Grid Grid.Row="1">
            <ProgressBar x:Name="MsgProgressBar" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="{ThemeResource PhoneAccentBrush}" Canvas.ZIndex="20" />

            <!-- 上传进度条面板 (媒体上传实时进度，带关闭/取消按钮) -->
            <Border x:Name="UploadProgressPanel" Visibility="Collapsed" Background="#E6000000" BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF" Padding="14,8" VerticalAlignment="Top" Canvas.ZIndex="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtUploadStatus" Text="正在上传..." FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ProgressBar x:Name="UploadProgressBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False" Height="4" Foreground="{ThemeResource PhoneAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtUploadPercentage" Grid.Column="2" Text="0%" FontSize="13" Foreground="{ThemeResource PhoneAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Button x:Name="BtnCancelUpload" Grid.Column="3" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" Margin="10,0,0,0" Background="Transparent" BorderThickness="0" Click="BtnCancelUpload_Click" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Cancel" Foreground="#FFCCCCCC" />
                    </Button>
                </Grid>
            </Border>

            <!-- 空消息状态提示 -->
            <StackPanel x:Name="EmptyMsgPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
                <TextBlock Text="暂无历史消息记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="在下方输入框发送消息开始畅聊吧" FontSize="13" Foreground="{ThemeResource PhoneMidBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 消息虚拟化列表 -->
            <ListView x:Name="ChatListView"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Loaded="ChatListView_Loaded"
                      Padding="12,8">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- KeepItemsInView: 插入历史消息时严格锁定当前视口中消息位置，彻底杜绝跳动与重复对齐 -->
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" CacheLength="30.0" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <!-- 彻底禁用条目滚动进入/离开时的渐变淡入动画，消除肉眼所见的跳动与闪烁感 -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.Header>
                    <!-- 仅作视觉指示，自动滚到顶时由代码触发，无需手动点击 -->
                    <Border x:Name="TopLoadMoreBorder" HorizontalAlignment="Stretch" Padding="8,8" Margin="0,0,0,8" Background="Transparent" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ProgressRing x:Name="TopLoadingRing" IsActive="False" Width="18" Height="18" Foreground="{ThemeResource PhoneMidBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtTopLoadMore" Text="正在加载历史消息..." FontSize="12" Foreground="{ThemeResource PhoneMidBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ListView.Header>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,4" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Stretch" Margin="0,3">
                            
                            <!-- A. 对方发送的消息 (左侧气泡，无圆角) -->
                            <Grid HorizontalAlignment="Left" Visibility="{Binding OtherBubbleVisibility}" Margin="0,0,40,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 对方头像 (Metro 直角 34x34) -->
                                <Grid Width="34" Height="34" VerticalAlignment="Top" Margin="0,2,6,0" Tapped="Avatar_Tapped">
                                    <Border Background="#FF555555" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding AvatarLetterVisibility}">
                                        <TextBlock Text="{Binding SenderAvatarLetter}" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding SenderAvatarBitmap}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                    <!-- 发送者昵称 (群聊显示) -->
                                    <TextBlock Text="{Binding DisplaySenderName}" FontSize="11" Foreground="{ThemeResource PhoneMidBrush}" Margin="2,0,0,3" Visibility="{Binding ShowSenderNameVisibility}" TextTrimming="CharacterEllipsis" MaxWidth="240" />

                                    <!-- 消息气泡 (半透明深色背景，无圆角) -->
                                    <Border Background="#20FFFFFF" BorderThickness="1" BorderBrush="#33FFFFFF" Padding="8,6" Tapped="MessageBubble_Tapped">
                                        <StackPanel>
                                            <!-- 视频消息预览块 (紧凑单行，带播放图标与时长提示) -->
                                            <Border Visibility="{Binding VideoMsgVisibility}" 
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="0,2" 
                                                    Tapped="VideoBubble_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto" />
                                                         <ColumnDefinition Width="Auto" />
                                                         <ColumnDefinition Width="Auto" />
                                                         <ColumnDefinition Width="*" />
                                                         <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <SymbolIcon Symbol="Video" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="[视频] 点击播放" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedVideoDuration}" FontSize="11" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding FormattedTime}" FontSize="10" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>

                                            <!-- 图片消息预览块 (紧凑单行) -->
                                            <Border Visibility="{Binding ImageMsgVisibility}" 
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="0,2" 
                                                    Tapped="ImageBubble_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <SymbolIcon Symbol="Pictures" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="[图片] 点击查看" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedTime}" FontSize="10" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>

                                            <!-- 文件消息卡片 (文件名、大小、进度条、下载状态) -->
                                            <Border Visibility="{Binding FileMsgVisibility}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0,2"
                                                    MinWidth="180"
                                                    MaxWidth="240"
                                                    Tapped="FileBubble_Tapped">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <SymbolIcon Symbol="OpenFile" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding DisplayFileName}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                            <TextBlock Text="{Binding FormattedFileSize}" FontSize="11" Foreground="#99FFFFFF" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- 下载进度条 -->
                                                    <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" IsIndeterminate="False" Height="4" Foreground="{ThemeResource PhoneAccentBrush}" Margin="0,6,0,2" Visibility="{Binding DownloadProgressVisibility}" />

                                                    <!-- 底部操作状态与时间 -->
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DownloadStatusText}" FontSize="11" Foreground="{ThemeResource PhoneAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="10" Foreground="#88FFFFFF" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- 动态/文章消息预览块 (动态图标 + 动态标题) -->
                                            <Border Visibility="{Binding PostMsgVisibility}" 
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="0,2" 
                                                    MinWidth="180"
                                                    MaxWidth="240"
                                                    Tapped="PostBubble_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <SymbolIcon Symbol="PostUpdate" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPostTitle}" FontSize="13" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedTime}" FontSize="10" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>

                                            <!-- HTML 网页富文本消息预览卡片 (不渲染复杂 HTML，点击直接进入查看/复制页) -->
                                            <Border Visibility="{Binding HtmlMsgVisibility}" 
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="0,2" 
                                                    MinWidth="180"
                                                    Tapped="HtmlBubble_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <SymbolIcon Symbol="Globe" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="[网页HTML] 点击查看全文/复制" FontSize="13" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedTime}" FontSize="10" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                </Grid>
                                            </Border>

                                            <!-- 纯文本消息内容 -->
                                            <StackPanel Visibility="{Binding TextMsgVisibility}">
                                                <TextBlock Text="{Binding DisplayText}" FontSize="15" Foreground="White" TextWrapping="Wrap" LineHeight="20" />
                                                <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#88FFFFFF" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- B. 我方发送的消息 (右侧气泡，无圆角) -->
                            <Grid HorizontalAlignment="Right" Visibility="{Binding SelfBubbleVisibility}" Margin="40,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Right">
                                    <!-- 消息气泡 (主题色实色背景，无圆角) -->
                                    <Border Background="{ThemeResource PhoneAccentBrush}" Padding="8,6" Tapped="MessageBubble_Tapped">
                                        <StackPanel>
                                            <!-- 视频消息预览块 (紧凑单行，带播放图标与时长提示) -->
                                            <Border Visibility="{Binding VideoMsgVisibility}" 
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="0,2" 
                                                    Tapped="VideoBubble_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto" />
                                                         <ColumnDefinition Width="Auto" />
                                                         <ColumnDefinition Width="Auto" />
                                                         <ColumnDefinition Width="*" />
                                                         <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <SymbolIcon Symbol="Video" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="[视频] 点击播放" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedVideoDuration}" FontSize="11" Foreground="#DDFFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding FormattedTime}" FontSize="10" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>

                                            <!-- 图片消息预览块 (紧凑单行) -->
                                            <Border Visibility="{Binding ImageMsgVisibility}" 
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="0,2" 
                                                    Tapped="ImageBubble_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <SymbolIcon Symbol="Pictures" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="[图片] 点击查看" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedTime}" FontSize="10" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>

                                            <!-- 文件消息卡片 (文件名、大小、进度条、下载状态) -->
                                            <Border Visibility="{Binding FileMsgVisibility}"
                                                    Background="Transparent"
                                                    BorderThickness="0" 
                                                    Padding="0,2"
                                                    MinWidth="180"
                                                    MaxWidth="240"
                                                    Tapped="FileBubble_Tapped">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <SymbolIcon Symbol="OpenFile" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding DisplayFileName}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                            <TextBlock Text="{Binding FormattedFileSize}" FontSize="11" Foreground="#CCFFFFFF" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- 下载进度条 -->
                                                    <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" IsIndeterminate="False" Height="4" Foreground="White" Margin="0,6,0,2" Visibility="{Binding DownloadProgressVisibility}" />

                                                    <!-- 底部操作状态与时间 -->
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DownloadStatusText}" FontSize="11" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="10" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- 动态/文章消息预览块 (动态图标 + 动态标题) -->
                                            <Border Visibility="{Binding PostMsgVisibility}" 
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="0,2" 
                                                    MinWidth="180"
                                                    MaxWidth="240"
                                                    Tapped="PostBubble_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <SymbolIcon Symbol="PostUpdate" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPostTitle}" FontSize="13" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedTime}" FontSize="10" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>

                                            <!-- HTML 网页富文本消息预览卡片 (不渲染复杂 HTML，点击直接进入查看/复制页) -->
                                            <Border Visibility="{Binding HtmlMsgVisibility}" 
                                                    Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Padding="0,2" 
                                                    MinWidth="180"
                                                    Tapped="HtmlBubble_Tapped">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <SymbolIcon Symbol="Globe" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="[网页HTML] 点击查看全文/复制" FontSize="13" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedTime}" FontSize="10" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                </Grid>
                                            </Border>

                                            <!-- 纯文本消息内容 -->
                                            <StackPanel Visibility="{Binding TextMsgVisibility}">
                                                <TextBlock Text="{Binding DisplayText}" FontSize="15" Foreground="White" TextWrapping="Wrap" LineHeight="20" />
                                                <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#CCFFFFFF" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 我方头像 (Metro 直角 34x34) -->
                                <Grid Grid.Column="1" Width="34" Height="34" VerticalAlignment="Top" Margin="6,2,0,0" Tapped="Avatar_Tapped">
                                    <Border Background="{ThemeResource PhoneAccentBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding AvatarLetterVisibility}">
                                        <TextBlock Text="{Binding SenderAvatarLetter}" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding SenderAvatarBitmap}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>
                            </Grid>

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 3. 底部 Metro 消息输入栏 (纯几何直角，紧凑利落) -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 消息输入框 (无圆角) -->
                <TextBox x:Name="TxtInput"
                         PlaceholderText="输入消息..."
                         Margin="0,0,8,0"
                         BorderThickness="1"
                         KeyDown="TxtInput_KeyDown"
                         GotFocus="TxtInput_GotFocus"
                         VerticalAlignment="Center" />

                <!-- 发送按钮 (采用 Windows Phone 标准 Forward 箭头图标，ClickMode="Press" 触摸即发) -->
                <Button x:Name="BtnSend"
                        Grid.Column="1"
                        MinWidth="42"
                        MinHeight="36"
                        Width="46"
                        Height="36"
                        Padding="0"
                        Margin="0"
                        BorderThickness="0"
                        Background="{ThemeResource PhoneAccentBrush}"
                        ClickMode="Press"
                        IsTabStop="False"
                        Click="BtnSend_Click"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="6,4">
                                <SymbolIcon Symbol="Forward" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>

    <!-- 原生 Windows Phone 8.1 底部可抽拉 CommandBar (默认极简收回只留三个点，点击或上滑即可抽拉展开) -->
    <Page.BottomAppBar>
        <CommandBar x:Name="ChatCommandBar" 
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" 
                    ClosedDisplayMode="Minimal"
                    IsOpen="False"
                    IsSticky="False">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="AppBarBtnPickImage" Icon="Pictures" Label="发送图片" Click="AppBarBtnPickImage_Click" />
                <AppBarButton x:Name="AppBarBtnSendVideo" Icon="Video" Label="发送视频" Click="AppBarBtnSendVideo_Click" />
                <AppBarButton x:Name="AppBarBtnSendFile" Icon="OpenFile" Label="发送文件" Click="AppBarBtnSendFile_Click" />
                <AppBarButton x:Name="AppBarBtnSendUrl" Icon="World" Label="媒体链接" Click="AppBarBtnSendUrl_Click" />
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="AppBarBtnRefresh" Label="刷新聊天" Click="BtnRefresh_Click" />
                <AppBarButton x:Name="AppBarBtnClearInput" Label="清空输入框" Click="AppBarBtnClearInput_Click" />
                <AppBarButton x:Name="AppBarBtnScrollBottom" Label="滚动到底部" Click="AppBarBtnScrollBottom_Click" />
                <AppBarButton x:Name="AppBarBtnViewLogs" Label="查看诊断日志" Click="AppBarBtnViewLogs_Click" />
            </CommandBar.SecondaryCommands>
