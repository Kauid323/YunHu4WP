<Page
    x:Class="云湖WP.ImageViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:云湖WP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Grid Background="Black">
        <!-- 顶部加载进度条与中心旋转圈 -->
        <ProgressBar x:Name="ImgProgressBar" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="{ThemeResource PhoneAccentBrush}" Canvas.ZIndex="30" />
        <ProgressRing x:Name="ImgProgressRing" IsActive="False" Visibility="Collapsed" Width="50" Height="50" Foreground="{ThemeResource PhoneAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Canvas.ZIndex="35" />

        <!-- 纯全屏手势缩放与查看区 -->
        <ScrollViewer x:Name="ImgScrollViewer" 
                      HorizontalScrollBarVisibility="Hidden" 
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Auto"
                      VerticalScrollMode="Auto"
                      ZoomMode="Enabled" 
                      MinZoomFactor="1.0" 
                      MaxZoomFactor="5.0"
                      Background="Black"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      DoubleTapped="ImgScrollViewer_DoubleTapped"
                      SizeChanged="ImgScrollViewer_SizeChanged">
            <Grid x:Name="ImageContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 纯字形默认头像块 (当无头像图片或未设置头像时在中心大尺寸展示) -->
                <Border x:Name="BorderAvatarLetter" Width="180" Height="180" Background="{ThemeResource PhoneAccentBrush}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAvatarLetter" Text="云" FontSize="72" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image x:Name="ImgFull" 
                       Stretch="Uniform" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" />
            </Grid>
        </ScrollViewer>

        <!-- 加载失败提示 -->
        <StackPanel x:Name="PanelError" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0" Canvas.ZIndex="20">
            <SymbolIcon Symbol="Cancel" Foreground="#FFAAAAAA" Margin="0,0,0,12" HorizontalAlignment="Center" />
            <TextBlock x:Name="TxtErrorReason" Text="图片加载失败" FontSize="15" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,14" TextWrapping="Wrap" TextAlignment="Center" />
            <Button x:Name="BtnReload" Content="重新加载图片" BorderThickness="1" Click="BtnReload_Click" HorizontalAlignment="Center" Padding="20,8" />
        </StackPanel>

        <!-- 右下角 Metro 悬浮保存按钮 (纯几何直角半透明) -->
        <Button x:Name="BtnSave" 
                Visibility="Collapsed"
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,18,21" 
                Padding="13,10" 
                Background="#B0000000" 
                BorderBrush="#55FFFFFF" 
                BorderThickness="1" 
                Click="BtnSave_Click" 
                Canvas.ZIndex="25">
            <StackPanel Orientation="Horizontal">
                <SymbolIcon Symbol="Save" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
